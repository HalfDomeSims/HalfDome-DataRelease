#!/bin/bash
#SBATCH -A m3058
#SBATCH -C cpu
#SBATCH -q debug
#SBATCH -t 0:30:00
#SBATCH -N 8
#SBATCH -o /pscratch/sd/a/abayer/joboutput/%x.o%j
#SBATCH -J 1map-cat
#SBATCH --mail-type=ALL
#SBATCH --mail-user=abayer@berkeley.edu

module load python
conda activate nbodykit

srun -N ${SLURM_NNODES} --ntasks-per-node 16 -c 16 python 1map-cat.py


